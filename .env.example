# Vikunja MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Base URL of your Vikunja instance
# Example: https://vikunja.example.com or http://localhost:3456
VIKUNJA_URL=

# Required: API token for authentication
# To obtain a token:
# 1. Log into your Vikunja instance
# 2. Go to Settings > API Tokens
# 3. Create a new token with the required permissions
# 4. Copy the token value here
VIKUNJA_API_TOKEN=

# HTTP server configuration
PORT=3000
HOST=127.0.0.1

# Public base URL (used in OAuth redirects).
# Set this when the server is behind a reverse proxy or tunnel.
# Example: https://vikunja-mcp.example.com
BASE_URL=http://127.0.0.1:3000

# Optional: Password to protect the MCP endpoint via OAuth 2.1.
# When set, Claude Desktop/Web will prompt the user to enter this password
# before accessing the MCP tools. Leave unset for unauthenticated local use.
MCP_AUTH_TOKEN=

# Optional: Directory for persisting OAuth tokens across restarts.
# Defaults to ~/.vikunja-mcp
# DATA_DIR=

# Optional: Number of days before refresh tokens expire (default: 14)
# MCP_REFRESH_DAYS=14
